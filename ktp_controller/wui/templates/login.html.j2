{% import "partials/_locale_menu.html.j2" as locale_menu %}
{% import "partials/_logo.html.j2" as logo %}
{% autoescape true %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ _("Exam server") }} &mdash; {{ _("Management panel") }}</title>
    <link rel="stylesheet" href="{{ prefix }}/static/pico.min.css">
    <link rel="stylesheet" href="{{ prefix }}/static/app.css">
    <link rel="icon" type="image/x-icon" href="{{ prefix }}/static/favicon.ico">
    <script src="{{ prefix }}/static/locale_switcher.js"></script>
</head>
<body>

{% if not session %}
<header class="container">
    <nav>
        <ul>
            <li>{{ logo.img(prefix) }}</li>
        </ul>
        <ul class="locale-nav">
            <li>{{ locale_menu.form("get", prefix ~ "/login", "lang", next, locale, _('Language')) }}</li>
        </ul>
    </nav>
</header>
{% endif %}

<main class="container login-container">

    <h1>{{ _("Exam server") }}</h1>
    <h2>{{ _("Management panel") }}</h2>
    {% if session %}

    <p>{% trans username=session.username %}Logged in as <strong>{{ username }}</strong>.{% endtrans %}</p>

    <form method="post" action="{{ prefix }}/logout">
        <button type="submit">{{ _("Log out") }}</button>
    </form>
    {% else %}

    {% if error %}
    <p class="login-error">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ prefix }}/login">
        <input type="hidden" name="next" value="{{ next }}">
        <input type="hidden" name="lang" value="{{ locale }}">
        <label for="username">{{ _("Username") }}</label>
        <input type="text" id="username" name="username" required autofocus>
        <label for="password">{{ _("Password") }}</label>
        <input type="password" id="password" name="password" required>
        <button type="submit">{{ _("Log in") }}</button>
    </form>
    {% endif %}

</main>
</body>
</html>
{% endautoescape %}
