{% autoescape true %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ _("Log in") }}</title>
    <link rel="stylesheet" href="/static/pico.min.css">
    <link rel="stylesheet" href="/static/app.css">
</head>
<body>
<main class="container login-container">

    {% if not session %}
    <nav>
        <ul>
            <li><a href="/login?next={{ next | urlencode }}&lang=fi">Suomi</a></li>
            <li><a href="/login?next={{ next | urlencode }}&lang=en">English</a></li>
            <li><a href="/login?next={{ next | urlencode }}&lang=sv">Svenska</a></li>
        </ul>
    </nav>
    {% endif %}

    {% if session %}
    <h2>{{ _("Logged in") }}</h2>

    <p>{% trans username=session.username %}Logged in as <strong>{{ username }}</strong>.{% endtrans %}</p>

    <form method="post" action="/logout">
        <button type="submit">{{ _("Log out") }}</button>
    </form>
    {% else %}
    <h2>{{ _("Log in") }}</h2>

    {% if error %}
    <p class="login-error">{{ error }}</p>
    {% endif %}

    <form method="post" action="/login">
        <input type="hidden" name="next" value="{{ next }}">
        <input type="hidden" name="lang" value="{{ locale }}">
        <label for="username">{{ _("Username") }}</label>
        <input type="text" id="username" name="username" required autofocus>
        <label for="password">{{ _("Password") }}</label>
        <input type="password" id="password" name="password" required>
        <button type="submit">{{ _("Log in") }}</button>
    </form>
    {% endif %}

</main>
</body>
</html>
{% endautoescape %}
