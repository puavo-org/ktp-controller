{% macro icon() %}
<svg class="severity-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 3 1 21h22L12 3z" stroke-width="2"/>
    <line x1="12" y1="9" x2="12" y2="14" stroke-width="2"/>
    <circle cx="12" cy="17.5" r="1" fill="currentColor" stroke="none"/>
</svg>
{% endmacro %}

{% macro card_header(title, severity) %}
<header{% if severity %} class="value-{{ severity }}"{% endif %}>
    <span class="value-with-icon">
        {{ title }}
        {% if severity %}{{ icon() }}{% endif %}
    </span>
</header>
{% endmacro %}
