{% set _LOCALES = [
    ("fi", "🇫🇮", "Suomi"),
    ("en", "🇬🇧", "English"),
    ("sv", "🇸🇪", "Svenska"),
] %}

{% macro options(locale) %}
{%- for code, emoji, name in _LOCALES %}
<option value="{{ code }}" {{ "selected" if locale == code else "" }}>{{ emoji }} {{ name }}</option>
{%- endfor %}
{% endmacro %}

{% macro flag(locale) %}
{%- for code, emoji, name in _LOCALES -%}
{%- if code == locale %}{{ emoji }}{% endif -%}
{%- endfor -%}
{% endmacro %}

{% macro form(method, action, field_name, next_value, locale, aria_label) %}
<form method="{{ method }}" action="{{ action }}">
    <input type="hidden" name="next" value="{{ next_value | e }}">
    <select name="{{ field_name }}" class="locale-select" aria-label="{{ aria_label }}">
        {{ options(locale) }}
    </select>
</form>
{% endmacro %}
