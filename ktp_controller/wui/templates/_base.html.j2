{% import "partials/_locale_menu.html.j2" as locale_menu %}
{% import "partials/_logo.html.j2" as logo %}
<!DOCTYPE html>
<html lang="{{ locale }}" data-prefix="{{ prefix }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="{{ prefix }}/static/pico.min.css">
    <link rel="stylesheet" href="{{ prefix }}/static/app.css">
    <link rel="icon" type="image/x-icon" href="{{ prefix }}/static/favicon.ico">
    <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
    <script src="{{ prefix }}/static/htmx.min.js"></script>
    <script src="{{ prefix }}/static/locale_switcher.js"></script>
    {% block extra_scripts %}{% endblock %}
</head>
<body>

    <div id="connection-lost-overlay" class="modal-overlay">
        <div class="modal-overlay-content">
            <p>{{ _("Connection lost at") }} <span id="connection-lost-timestamp"></span></p>
            <p>{{ _("The page will reload automatically once it's back.") }}</p>
        </div>
    </div>

    {% block modals %}{% endblock %}

    <header class="container">
        <nav>
            <ul>
                <li>
                    <a class="dashboard-link" href="{{ prefix }}/" aria-label="{{ _('Exam server') }}" {% if request.url.path == prefix + "/" %}aria-current="page"{% endif %}>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                    </a>
                </li>
                <li>{{ logo.img(prefix) }}</li>
                <li><a href="{{ prefix }}/invigilator/" {% if request.url.path == prefix + "/invigilator/" %}aria-current="page"{% endif %}>{{ _("Exams") }}</a></li>
                <li><a href="{{ prefix }}/invigilator/student_access_code" {% if request.url.path == prefix + "/invigilator/student_access_code" %}aria-current="page"{% endif %}>{{ _("Student access code") }}</a></li>
            </ul>
            {% block nav_live_status %}{% endblock %}
            <ul>
                <li>
                    <details class="dropdown">
                        <summary>{{ locale_menu.flag(locale) }} {{ user }}</summary>
                        <ul>
                            <li>
                                {{ locale_menu.form("post", prefix ~ "/locale", "locale", request.url.path, locale, _('Language')) }}
                            </li>
                            <li>
                                <form method="post" action="{{ prefix }}/logout">
                                    <button type="submit" class="secondary">{{ _("Log out") }}</button>
                                </form>
                            </li>
                        </ul>
                    </details>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

</body>
</html>
