{% import "partials/_locale_menu.html.j2" as locale_menu %}
{% import "partials/_logo.html.j2" as logo %}
<!DOCTYPE html>
<html lang="{{ locale }}" data-prefix="{{ prefix }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="{{ prefix }}/static/pico.min.css">
    <link rel="stylesheet" href="{{ prefix }}/static/app.css">
    <link rel="icon" type="image/x-icon" href="{{ prefix }}/static/favicon.ico">
    <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
    <script src="{{ prefix }}/static/htmx.min.js"></script>
    <script src="{{ prefix }}/static/locale_switcher.js"></script>
    <script src="{{ prefix }}/static/ktp_wui.js"></script>
    <script src="{{ prefix }}/static/sidebar_toggle.js"></script>
    {% block extra_scripts %}{% endblock %}
</head>
<body class="app-shell">

    <div id="connection-lost-overlay" class="modal-overlay">
        <div class="modal-overlay-content">
            <p>{{ _("Connection lost at") }} <span id="connection-lost-timestamp"></span></p>
            <p>{{ _("The page will reload automatically once it's back.") }}</p>
        </div>
    </div>

    {% block modals %}{% endblock %}

    {% if self.sidebar() | trim %}
    <button type="button"
            class="sidebar-toggle-button icon-toggle-button"
            aria-expanded="false"
            aria-controls="app-sidebar"
            aria-label="{% block sidebar_toggle_label %}{{ _("More info") }}{% endblock %}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="2" y="4" width="20" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
            <line x1="15" y1="4" x2="15" y2="20" stroke="currentColor" stroke-width="2"/>
        </svg>
    </button>
    {% endif %}

    <header class="container">
        <nav>
            <ul>
                <li>{{ logo.img(prefix) }}</li>
                {% include "partials/nav_exam_server_link.html.j2" %}
                <li><a href="{{ prefix }}/invigilator/" {% if request.url.path == prefix + "/invigilator/" %}aria-current="page"{% endif %}>{{ _("Exams") }}</a></li>
                <li><a href="{{ prefix }}/invigilator/student_access_code" {% if request.url.path == prefix + "/invigilator/student_access_code" %}aria-current="page"{% endif %}>{{ _("Student access code") }}</a></li>
            </ul>
            {% block nav_live_status %}{% endblock %}
            <ul>
                <li>
                    <details class="dropdown">
                        <summary>{{ locale_menu.flag(locale) }} {{ user }}</summary>
                        <ul>
                            <li>
                                {{ locale_menu.form("post", prefix ~ "/locale", "locale", request.url.path, locale, _('Language')) }}
                            </li>
                            <li>
                                <form method="post" action="{{ prefix }}/logout">
                                    <button type="submit" class="secondary">{{ _("Log out") }}</button>
                                </form>
                            </li>
                        </ul>
                    </details>
                </li>
            </ul>
        </nav>
    </header>

    <div class="app-shell-body">
        <main class="container">
            {% block content %}{% endblock %}
        </main>
        <aside id="app-sidebar" class="app-sidebar" hidden>
            {% block sidebar %}{% endblock %}
        </aside>
    </div>
    <footer class="container">
      {% if abitti2_domain %}<span class="footer-domain">{{ abitti2_domain }}</span>{% endif %}
      {% if puavo_fqdn %}<span class="footer-domain">{{ puavo_fqdn }}</span>{% endif %}
      <small id="page-refreshed-status"
             class="page-refreshed-status"
             data-template-one="{{ _('Page refreshed {n} second ago') }}"
             data-template-other="{{ _('Page refreshed {n} seconds ago') }}"></small>
    </footer>
</body>
</html>
