{% extends "_base.html.j2" %}
{% import "partials/_severity.html.j2" as severity_macros %}

{% block title %}{{ _("Exam server") }}{% endblock %}

{% block extra_scripts %}
    <script src="{{ prefix }}/static/status_updates.js"></script>
    <script src="{{ prefix }}/static/page_refreshed_status.js"></script>
    <script src="{{ prefix }}/static/controller_started_at.js"></script>
    <script src="{{ prefix }}/static/abitti2_cert_expires_at.js"></script>
    <script src="{{ prefix }}/static/host_uptime.js"></script>
{% endblock %}

{% block nav_live_status %}
    {% include "partials/nav_student_state_counts.html.j2" %}
{% endblock %}

{% block content %}

    <h2>{{ _("Exam server") }}</h2>

    <div class="grid landing-cards">

        {% if "controller_info" in visible_card_keys %}
        <article>
            <header id="controller-info-header">
                <span class="value-with-icon">
                    {{ _("Controller info") }}
                    {{ severity_macros.icon(id="controller-info-header-icon", hidden=True) }}
                </span>
            </header>
            {% if controller_info %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Version") }}</td>
                    <td>{{ controller_info.version }}</td>
                </tr>
                <tr>
                    <td>{{ _("Started at") }}</td>
                    <td id="controller-started-at-cell">
                        <span class="value-with-icon">
                            <span id="controller-started-at"
                                  data-tooltip="{{ controller_info.started_at|localize_datetime(locale) }}"
                                  data-started-at="{{ controller_info.started_at.isoformat() }}"
                                  data-seconds-one="{{ _('{n} second ago') }}"
                                  data-seconds-other="{{ _('{n} seconds ago') }}"
                                  data-minutes-one="{{ _('{n} minute ago') }}"
                                  data-minutes-other="{{ _('{n} minutes ago') }}"
                                  data-hours-one="{{ _('{n} hour ago') }}"
                                  data-hours-other="{{ _('{n} hours ago') }}"
                                  data-days-one="{{ _('{n} day ago') }}"
                                  data-days-other="{{ _('{n} days ago') }}"></span>
                            {{ severity_macros.icon(id="controller-started-at-icon", hidden=True) }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td>{{ _("Auto control") }}</td>
                    <td>
                        {# Not wired to an action yet: add
                           hx-post="{{ prefix }}/actions/toggle-auto-control"
                           hx-swap="none" (dispatching
                           Command.ENABLE_AUTO_CONTROL /
                           Command.DISABLE_AUTO_CONTROL) once that endpoint
                           and its wui.actions.toggle-auto-control permission
                           exist. #}
                        <input type="checkbox"
                               role="switch"
                               aria-label="{{ _('Auto control') }}"
                               {{ "checked" if controller_info.is_auto_control_enabled else "" }}
                               {{ "" if can_toggle_auto_control else "disabled" }}>
                    </td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

        {% if "abitti2_info" in visible_card_keys %}
        <article>
            {{ severity_macros.card_header(_("Abitti2"), abitti2_info.severity if abitti2_info else None) }}
            {% if abitti2_info and abitti2_info.version and abitti2_info.server_name %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Version") }}</td>
                    <td>{{ abitti2_info.version }}</td>
                </tr>
                <tr>
                    <td>{{ _("Name") }}</td>
                    <td>{{ abitti2_info.server_name }}</td>
                </tr>
                <tr>
                    <td>{{ _("Certificate expires") }}</td>
                    <td{% if abitti2_info.severity %} class="value-{{ abitti2_info.severity }}"{% endif %}>
                        <span class="value-with-icon">
                            <span id="abitti2-cert-expires-at"
                                  {% if abitti2_info.cert_expires_at %}data-tooltip="{{ abitti2_info.cert_expires_at|localize_datetime(locale) }}" data-cert-expires-at="{{ abitti2_info.cert_expires_at.isoformat() }}"{% endif %}>{{ abitti2_info.cert_expires_at|localize_date(locale) if abitti2_info.cert_expires_at else "???" }}</span>
                            {% if abitti2_info.severity %}{{ severity_macros.icon() }}{% endif %}
                        </span>
                        {% if abitti2_info.cert_expiry_countdown_text %}
                        <small class="severity-caption">{{ abitti2_info.cert_expiry_countdown_text }}</small>
                        {% endif %}
                    </td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

        {% if "host_info" in visible_card_keys %}
        <article>
            {{ severity_macros.card_header(_("Host system"), host_info.severity if host_info else None) }}
            {% if host_info %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Version") }}</td>
                    <td>
                      <span {% if host_info.puavo_os_image_name %} data-tooltip="{{ host_info.puavo_os_image_name }}"{% endif %}>{{ host_info.puavo_os_image_release or "???" }}</span>
                    </td>
                </tr>
                <tr>
                    <td>{{ _("Name") }}</td>
                    <td>{{ host_info.hostname or "???" }}</td>
                </tr>
                <tr>
                    <td>{{ _("Started at") }}</td>
                    <td id="host-uptime-cell">
                        <span class="value-with-icon">
                            <span id="host-uptime"
                                  {% if host_info.started_at %}data-tooltip="{{ host_info.started_at|localize_datetime(locale) }}" data-started-at="{{ host_info.started_at.isoformat() }}"{% endif %}
                                  data-minutes-one="{{ _('{n} minute ago') }}"
                                  data-minutes-other="{{ _('{n} minutes ago') }}"
                                  data-hours-one="{{ _('{n} hour ago') }}"
                                  data-hours-other="{{ _('{n} hours ago') }}"
                                  data-days-one="{{ _('{n} day ago') }}"
                                  data-days-other="{{ _('{n} days ago') }}">{{ "" if host_info.started_at else "???" }}</span>
                            {{ severity_macros.icon(id="host-uptime-icon", hidden=True) }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td>{{ _("Free disk space") }}</td>
                    <td{% if host_info.severity %} class="value-{{ host_info.severity }}"{% endif %}>
                        <span class="value-with-icon">
                            <span>{{ disk_space_stage_labels[host_info.free_disk_space_stage] if host_info.free_disk_space_stage else "???" }}</span>
                            {% if host_info.severity %}{{ severity_macros.icon() }}{% endif %}
                        </span>
                    </td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

    </div>

{% endblock %}
