{% extends "_base.html.j2" %}

{% block title %}{{ _("Exam server") }}{% endblock %}

{% block content %}

    <h2>{{ _("Exam server") }}</h2>

    <div class="grid">

        {% if "general_info" in visible_card_keys %}
        <article>
            <header>{{ _("General information") }}</header>
            {% if general_info %}
            <p>{% trans version=general_info.version %}Version: {{ version }}{% endtrans %}</p>
            <p>{% trans started_at=general_info.started_at|localize_datetime(locale) %}Started at: {{ started_at }}{% endtrans %}</p>
            <p>
                {% if general_info.is_auto_control_enabled %}
                {{ _("Auto control: enabled") }}
                {% else %}
                {{ _("Auto control: disabled") }}
                {% endif %}
            </p>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

        {% if "abitti2" in visible_card_keys %}
        <article>
            <header>{{ _("Abitti2") }}</header>
            {% if abitti2_info and abitti2_info.version %}
            <p>{% trans version=abitti2_info.version %}Version: {{ version }}{% endtrans %}</p>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

    </div>

{% endblock %}
