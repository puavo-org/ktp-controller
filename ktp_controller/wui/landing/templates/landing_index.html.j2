{% extends "_base.html.j2" %}

{% block title %}{{ _("Exam server") }}{% endblock %}

{% block extra_scripts %}
    <script src="{{ prefix }}/static/status_updates.js"></script>
{% endblock %}

{% block nav_live_status %}
    {% include "partials/nav_student_state_counts.html.j2" %}
{% endblock %}

{% block content %}

    <h2>{{ _("Exam server") }}</h2>

    <div class="grid">

        {% if "controller_info" in visible_card_keys %}
        <article>
            <header>{{ _("Controller info") }}</header>
            {% if controller_info %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Version") }}</td>
                    <td>{{ controller_info.version }}</td>
                </tr>
                <tr>
                    <td>{{ _("Started at") }}</td>
                    <td>{{ controller_info.started_at|localize_datetime(locale) }}</td>
                </tr>
                <tr>
                    <td>{{ _("Auto control") }}</td>
                    <td>
                        {# Not wired to an action yet: add
                           hx-post="{{ prefix }}/actions/toggle-auto-control"
                           hx-swap="none" (dispatching
                           Command.ENABLE_AUTO_CONTROL /
                           Command.DISABLE_AUTO_CONTROL) once that endpoint
                           and its wui.actions.toggle-auto-control permission
                           exist. #}
                        <input type="checkbox"
                               role="switch"
                               aria-label="{{ _('Auto control') }}"
                               {{ "checked" if controller_info.is_auto_control_enabled else "" }}
                               {{ "" if can_toggle_auto_control else "disabled" }}>
                    </td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

        {% if "abitti2_info" in visible_card_keys %}
        <article>
            <header>{{ _("Abitti2") }}</header>
            {% if abitti2_info and abitti2_info.version and abitti2_info.server_name %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Version") }}</td>
                    <td>{{ abitti2_info.version }}</td>
                </tr>
                <tr>
                    <td>{{ _("Server name") }}</td>
                    <td>{{ abitti2_info.server_name }}</td>
                </tr>
                <tr>
                    <td>{{ _("Certificate expires") }}</td>
                    <td{% if abitti2_info.cert_expiring_soon %} class="value-warning"{% endif %}>
                        <span class="value-with-icon">
                            <span>{{ abitti2_info.cert_expires_at|localize_date(locale) if abitti2_info.cert_expires_at else "???" }}</span>
                            {% if abitti2_info.cert_expiring_soon %}
                            <svg class="severity-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M12 3 1 21h22L12 3z" stroke-width="2"/>
                                <line x1="12" y1="9" x2="12" y2="14" stroke-width="2"/>
                                <circle cx="12" cy="17.5" r="1" fill="currentColor" stroke="none"/>
                            </svg>
                            {% endif %}
                        </span>
                        {% if abitti2_info.cert_expiry_countdown_text %}
                        <small class="severity-caption">{{ abitti2_info.cert_expiry_countdown_text }}</small>
                        {% endif %}
                    </td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

        {% if "os_info" in visible_card_keys %}
        <article>
            <header>{{ _("Operating system") }}</header>
            {% if os_info %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Release") }}</td>
                    <td{% if os_info.puavo_os_image_name %} title="{{ os_info.puavo_os_image_name }}"{% endif %}>{{ os_info.puavo_os_image_release or "???" }}</td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

    </div>

{% endblock %}
