{% extends "_base.html.j2" %}

{% block title %}{{ _("Exam server") }}{% endblock %}

{% block content %}

    <h2>{{ _("Exam server") }}</h2>

    <div class="grid">

        {% if "controller_info" in visible_card_keys %}
        <article>
            <header>{{ _("Controller info") }}</header>
            {% if controller_info %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Version") }}</td>
                    <td>{{ controller_info.version }}</td>
                </tr>
                <tr>
                    <td>{{ _("Started at") }}</td>
                    <td>{{ controller_info.started_at|localize_datetime(locale) }}</td>
                </tr>
                <tr>
                    <td>{{ _("Auto control") }}</td>
                    <td>
                        {# Not wired to an action yet: add
                           hx-post="{{ prefix }}/actions/toggle-auto-control"
                           hx-swap="none" (dispatching
                           Command.ENABLE_AUTO_CONTROL /
                           Command.DISABLE_AUTO_CONTROL) once that endpoint
                           and its wui.actions.toggle-auto-control permission
                           exist. #}
                        <input type="checkbox"
                               role="switch"
                               aria-label="{{ _('Auto control') }}"
                               {{ "checked" if controller_info.is_auto_control_enabled else "" }}
                               {{ "" if can_toggle_auto_control else "disabled" }}>
                    </td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

        {% if "abitti2" in visible_card_keys %}
        <article>
            <header>{{ _("Abitti2") }}</header>
            {% if abitti2_info and abitti2_info.version %}
            <table class="landing-card-table">
                <tr>
                    <td>{{ _("Version") }}</td>
                    <td>{{ abitti2_info.version }}</td>
                </tr>
            </table>
            {% else %}
            <p>{{ _("Not available yet.") }}</p>
            {% endif %}
        </article>
        {% endif %}

    </div>

{% endblock %}
