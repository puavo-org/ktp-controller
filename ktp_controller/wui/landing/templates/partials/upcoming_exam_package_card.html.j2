{% import "partials/_severity.html.j2" as severity_macros %}
{% set severity = upcoming_exam_package_info.severity if upcoming_exam_package_info else None %}
<article id="upcoming-exam-package-card"
         hx-get="{{ prefix }}/upcoming_exam_package"
         hx-trigger="live-update from:body throttle:2s"
         hx-target="this"
         hx-swap="outerHTML">
    <header id="upcoming-exam-package-header"{% if severity %} class="value-{{ severity }}"{% endif %}>
        <span class="value-with-icon">
            {{ _("Upcoming exam package") }}
            {{ severity_macros.icon(id="upcoming-exam-package-header-icon", hidden=not severity) }}
        </span>
    </header>
    {% if upcoming_exam_package_info %}
    {% set start_severity = upcoming_exam_package_info.start_severity %}
    {% set end_severity = upcoming_exam_package_info.end_severity %}
    <table class="landing-card-table">
        <tr>
            <td>{{ _("Scheduled start time") }}</td>
            <td id="upcoming-exam-package-scheduled-start-cell"{% if start_severity %} class="value-{{ start_severity }}"{% endif %}>
                <span class="value-with-icon">
                    <span id="upcoming-exam-package-scheduled-start"
                          data-tooltip="{{ upcoming_exam_package_info.start_time|localize_datetime(locale) }}"
                          data-scheduled-start="{{ upcoming_exam_package_info.start_time.isoformat() }}"
                          data-in-minutes-one="{{ _('in {n} minute') }}"
                          data-in-minutes-other="{{ _('in {n} minutes') }}"
                          data-in-hours-one="{{ _('in {n} hour') }}"
                          data-in-hours-other="{{ _('in {n} hours') }}"
                          data-in-days-one="{{ _('in {n} day') }}"
                          data-in-days-other="{{ _('in {n} days') }}"
                          data-late-minutes-one="{{ _('{n} minute late') }}"
                          data-late-minutes-other="{{ _('{n} minutes late') }}"
                          data-late-hours-one="{{ _('{n} hour late') }}"
                          data-late-hours-other="{{ _('{n} hours late') }}"
                          data-late-days-one="{{ _('{n} day late') }}"
                          data-late-days-other="{{ _('{n} days late') }}"></span>
                    {{ severity_macros.icon(id="upcoming-exam-package-scheduled-start-icon", hidden=not start_severity) }}
                </span>
            </td>
        </tr>
        <tr>
            <td>{{ _("Scheduled end time") }}</td>
            <td id="upcoming-exam-package-scheduled-end-cell"{% if end_severity %} class="value-{{ end_severity }}"{% endif %}>
                <span class="value-with-icon">
                    <span id="upcoming-exam-package-scheduled-end"
                          data-tooltip="{{ upcoming_exam_package_info.end_time|localize_datetime(locale) }}"
                          data-scheduled-end="{{ upcoming_exam_package_info.end_time.isoformat() }}"
                          data-in-minutes-one="{{ _('in {n} minute') }}"
                          data-in-minutes-other="{{ _('in {n} minutes') }}"
                          data-in-hours-one="{{ _('in {n} hour') }}"
                          data-in-hours-other="{{ _('in {n} hours') }}"
                          data-in-days-one="{{ _('in {n} day') }}"
                          data-in-days-other="{{ _('in {n} days') }}"
                          data-minutes-one="{{ _('{n} minute ago') }}"
                          data-minutes-other="{{ _('{n} minutes ago') }}"
                          data-hours-one="{{ _('{n} hour ago') }}"
                          data-hours-other="{{ _('{n} hours ago') }}"
                          data-days-one="{{ _('{n} day ago') }}"
                          data-days-other="{{ _('{n} days ago') }}"></span>
                    {{ severity_macros.icon(id="upcoming-exam-package-scheduled-end-icon", hidden=not end_severity) }}
                </span>
            </td>
        </tr>
        <tr>
            <td>{{ _("Locked") }}</td>
            <td id="upcoming-exam-package-locked">{{ _("Yes") if upcoming_exam_package_info.locked else _("No") }}</td>
        </tr>
    </table>
    {% else %}
    <p>{{ _("Not available yet.") }}</p>
    {% endif %}
</article>
