<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="/static/pico.min.css">
    <style>
      .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(5px);
        background: rgba(0, 0, 0, 0.75);
        text-align: center;
        z-index: 1000;
      }
      .modal-overlay.is-visible {
        display: flex;
      }
      .modal-overlay-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: var(--pico-card-background-color);
        color: var(--pico-color);
        padding: var(--pico-spacing) calc(var(--pico-spacing) * 2);
        border-radius: var(--pico-border-radius);
      }
      .modal-overlay-actions {
        display: flex;
        align-items: center;
        gap: var(--pico-spacing);
      }
      .modal-overlay-actions button {
        width: auto;
        margin-bottom: 0;
      }
      header nav {
        align-items: center;
      }
      header form {
        margin-bottom: 0;
      }
      header button,
      header select {
        width: auto;
      }
    </style>
    {% block extra_styles %}{% endblock %}
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="/static/status_updates.js"></script>
    <script src="/static/locale_switcher.js"></script>
    {% block extra_scripts %}{% endblock %}
</head>
<body>

    <div id="connection-lost-overlay" class="modal-overlay">
        <div class="modal-overlay-content">
            <p>{{ _("Connection lost at") }} <span id="connection-lost-timestamp"></span></p>
            <p>{{ _("The page will reload automatically once it's back.") }}</p>
        </div>
    </div>

    {% block modals %}{% endblock %}

    <header class="container">
        <nav>
            <ul>
                <li>{% trans user=user %}Logged in as <strong>{{ user }}</strong>{% endtrans %}</li>
            </ul>
            <ul>
                <li>
                    <form method="post" action="/locale">
                        <input type="hidden" name="next" value="{{ request.url.path }}">
                        <select name="locale" aria-label="{{ _('Language') }}">
                            <option value="fi" {{ "selected" if locale == "fi" else "" }}>Suomi</option>
                            <option value="en" {{ "selected" if locale == "en" else "" }}>English</option>
                            <option value="sv" {{ "selected" if locale == "sv" else "" }}>Svenska</option>
                        </select>
                    </form>
                </li>
                <li>
                    <form method="post" action="/logout">
                        <button type="submit" class="secondary">{{ _("Log out") }}</button>
                    </form>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

</body>
</html>
