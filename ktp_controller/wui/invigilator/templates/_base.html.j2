{% import "partials/_locale_menu.html.j2" as locale_menu %}
{% import "partials/_logo.html.j2" as logo %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="/static/pico.min.css">
    <link rel="stylesheet" href="/static/app.css">
    <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
    <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
    <script src="/static/htmx.min.js"></script>
    <script src="/static/status_updates.js"></script>
    <script src="/static/locale_switcher.js"></script>
    {% block extra_scripts %}{% endblock %}
</head>
<body>

    <div id="connection-lost-overlay" class="modal-overlay">
        <div class="modal-overlay-content">
            <p>{{ _("Connection lost at") }} <span id="connection-lost-timestamp"></span></p>
            <p>{{ _("The page will reload automatically once it's back.") }}</p>
        </div>
    </div>

    {% block modals %}{% endblock %}

    <header class="container">
        <nav>
            <ul>
                <li>{{ logo.img() }}</li>
                <li><a href="/invigilator/" {% if request.url.path == "/invigilator/" %}aria-current="page"{% endif %}>{{ _("Exams") }}</a></li>
                <li><a href="/invigilator/student_access_code" {% if request.url.path == "/invigilator/student_access_code" %}aria-current="page"{% endif %}>{{ _("Student access code") }}</a></li>
            </ul>
            {% include "partials/student_state_counts.html.j2" %}
            <ul>
                <li>
                    <details class="dropdown">
                        <summary>{{ locale_menu.flag(locale) }} {{ user }}</summary>
                        <ul>
                            <li>
                                {{ locale_menu.form("post", "/locale", "locale", request.url.path, locale, _('Language')) }}
                            </li>
                            <li>
                                <form method="post" action="/logout">
                                    <button type="submit" class="secondary">{{ _("Log out") }}</button>
                                </form>
                            </li>
                        </ul>
                    </details>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

</body>
</html>
