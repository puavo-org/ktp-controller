{% extends "_base.html.j2" %}

{% block title %}{{ _("Student access code") }}{% endblock %}

{% block extra_scripts %}
    <script src="{{ prefix }}/static/status_updates.js"></script>
    <script src="{{ prefix }}/static/page_refreshed_status.js"></script>
    <script src="{{ prefix }}/static/change_access_code_confirm.js"></script>
    <script src="{{ prefix }}/static/toggle_access_code.js"></script>
    <script src="{{ prefix }}/static/toggle_wifi_passphrase.js"></script>
{% endblock %}

{% block nav_live_status %}
    {% include "partials/student_state_counts.html.j2" %}
{% endblock %}

{% block modals %}
    {% if can_change_access_code %}
    <div id="change-access-code-confirm-overlay" class="modal-overlay">
        <div class="modal-overlay-content">
            <p>{{ _("Really change the student access code? The current code will stop working for every student using it.") }}</p>
            <div class="modal-overlay-actions">
                <button class="change-access-code-confirm-yes"
                        hx-post="{{ prefix }}/actions/change-student-access-code"
                        hx-swap="none">{{ _("Yes") }}</button>
                <button type="button" class="change-access-code-confirm-no">{{ _("No") }}</button>
            </div>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% block sidebar_toggle_label %}{{ _("Wi-Fi info") }}{% endblock %}

{% block sidebar %}
{% if wui_wifi_ssid %}
    <h3>{{ _("Wi-Fi info") }}</h3>
    <p>
        <strong>{{ _("Network name (SSID)") }}</strong><br>
        {{ wui_wifi_ssid }}
    </p>
    <p>
        <strong>{{ _("Password") }}</strong><br>
        <button type="button"
                class="wifi-passphrase-text toggle-wifi-passphrase-button"
                aria-pressed="false"
                aria-label="{{ _('Show Wi-Fi password') }}"
                data-wifi-passphrase="{{ wui_wifi_passphrase }}"
                data-show-label="{{ _('Show Wi-Fi password') }}"
                data-hide-label="{{ _('Hide Wi-Fi password') }}">{{ "•" * (wui_wifi_passphrase | length) }}</button>
    </p>
{% endif %}
{% endblock %}

{% block content %}

    <h2>{{ _("Student access code") }}</h2>

    {% include "partials/student_access_code_display.html.j2" %}

{% endblock %}
