<div id="student-access-code"
     hx-get="{{ prefix }}/invigilator/student_access_code"
     hx-trigger="live-update from:body throttle:2s"
     hx-target="this"
     hx-swap="outerHTML">
    <p class="access-code-text">
        {{ student_access_code_and_server_name.server_name if student_access_code_and_server_name else _("No server name available") }}
    </p>
    {% if student_access_code_and_server_name %}
    {% set code = student_access_code_and_server_name.student_access_code | string %}
    <button type="button"
            class="access-code-text toggle-access-code-button"
            aria-pressed="false"
            aria-label="{{ _('Show access code') }}"
            data-access-code="{{ code }}"
            data-show-label="{{ _('Show access code') }}"
            data-hide-label="{{ _('Hide access code') }}">{{ "•" * (code | length) }}</button>
    {% else %}
    <p class="access-code-text">{{ _("No access code available") }}</p>
    {% endif %}
    {% if can_change_access_code %}
    <button type="button" class="change-access-code-button">{{ _("Change access code") }}</button>
    {% endif %}
</div>
{# This partial is also rendered inside student_access_code.html.j2's
   own full-page response, where the counts are already rendered once
   in the common header - only emit the out-of-band counts update here
   when this template is the direct htmx response (live update), to
   avoid a duplicate #student-state-counts element. #}
{% if request.headers.get("HX-Request") %}
{% include "partials/student_state_counts.html.j2" %}
{% endif %}
