<table class="striped">
    <thead>
        <tr>
        {% for column_key, column_label, is_sortable in columns %}
        {% if is_sortable %}
            <th hx-get="?sort_by={{ column_key }}&order={{ order_next if sort_by == column_key else 'asc' }}"
                hx-target="#student-list-groups"
                hx-swap="outerHTML"
                hx-include="#filters"
                class="sortable-column">
                {{ column_label }}
                {% if sort_by == column_key %}{{ '▲' if order_now == 'asc' else '▼' }}{% endif %}
            </th>
        {% else %}
            <th>{{ column_label }}</th>
        {% endif %}
        {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for student_list_item in student_list_items %}
        <tr>
            <td>{{ student_list_item.name }}</td>
            <td>{{ student_list_item.birthday | localize_date(locale) }}</td>
            <td><span class="pill {{ state_pill_classes[student_list_item.state] }}">{{ (student_list_item.flags | translate_labels(flag_labels)) if student_list_item.state == "has_problems" else state_labels[student_list_item.state] }}</span></td>
            <td>{{ '-' if not student_list_item.last_changed_at else student_list_item.last_changed_at | localize_datetime(locale) }}</td>
            <td>{% if student_list_item.is_allowed_to_use_browser is none %}???{% else %}
              <input type="hidden"
                     id="browser-permission-session-uuid-{{ student_list_item.session_uuid }}"
                     name="session_uuid"
                     value="{{ student_list_item.session_uuid }}">
              <input type="hidden"
                     id="browser-permission-student-uuid-{{ student_list_item.student_uuid }}"
                     name="student_uuid"
                     value="{{ student_list_item.student_uuid }}">
              <input type="checkbox"
                     name="allow"
                     class="browser-permission-checkbox"
                     hx-post="/actions/set-exam-session-permission-to-use-browsers"
                     hx-include="#browser-permission-session-uuid-{{ student_list_item.session_uuid }}, #browser-permission-student-uuid-{{ student_list_item.student_uuid }}"
                     hx-swap="none"
                     {{ "checked" if student_list_item.is_allowed_to_use_browser else "" }}
                     {{ "" if can_set_browser_permission and student_list_item.state != 'finished' else "disabled" }}>
              {% endif %}
            </td>
            {% if can_reset_audio %}
            <td>
              {% if student_list_item.last_audio and can_allow_audio_replay %}
              <button type="button"
                      class="allow-audio-replay-button"
                      data-name="{{ student_list_item.name }}"
                      data-student-uuid="{{ student_list_item.student_uuid }}"
                      data-last-audio="{{ student_list_item.last_audio }}"
                      data-exam-title="{{ student_list_item.exam_title or '' }}">
                {{ _("Allow replaying audio %(n)s", n=student_list_item.last_audio) }}
              </button>
              {% endif %}
            </td>
            {% endif %}
	    <td>
              <button type="button"
                      class="end-exam-button"
                      data-name="{{ student_list_item.name }}"
                      data-session-uuid="{{ student_list_item.session_uuid }}"
                      data-student-uuid="{{ student_list_item.student_uuid }}"
                      {{ "" if can_end_exam and (student_list_item.state == 'in_exam' or (student_list_item.state == 'has_problems' and 'idle' in student_list_item.flags and student_list_item.flags | length == 1)) else "disabled" }}>
                {{ _("End exam") }}
              </button>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="{{ columns | length }}" class="text-center">{% if name_birthday_filter %}{{ _("No students matching '%(query)s'", query=name_birthday_filter) }}{% else %}{{ _("No students") }}{% endif %}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
