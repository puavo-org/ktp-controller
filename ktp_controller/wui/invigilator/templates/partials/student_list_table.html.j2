{% autoescape true %}
<table id="student-list-table"
       hx-get="?sort_by={{ sort_by }}&order={{ order_now }}"
       hx-trigger="student-list-update from:body throttle:2s"
       hx-target="this"
       hx-swap="outerHTML"
       hx-include="#filters"
       border="1" style="border-collapse: collapse; width: 100%; text-align: left;">
    <thead>
        <tr style="background-color: #f2f2f2;">
        {% for column_key, column_label, is_sortable in columns %}
        {% if is_sortable %}
            <th hx-get="?sort_by={{ column_key }}&order={{ order_next if sort_by == column_key else 'asc' }}"
                hx-target="#student-list-table"
                hx-swap="outerHTML"
                hx-include="#filters"
                style="cursor: pointer; padding: 8px;">
                {{ column_label }}
                {% if sort_by == column_key %}{{ '▲' if order_now == 'asc' else '▼' }}{% endif %}
            </th>
        {% else %}
            <th style="padding: 8px;">{{ column_label }}</th>
        {% endif %}
        {% endfor %}
        </tr>
    </thead>
    <tbody id="student-list-table-body">
        {% for student_list_item in student_list_items %}
        <tr>
            <td style="padding: 8px;">{{ student_list_item.name }}</td>
            <td style="padding: 8px;">{{ student_list_item.birthday.isoformat() }}</td>
            <td style="padding: 8px;">{{ student_list_item.state.capitalize() }}</td>
            <td style="padding: 8px;">{{ student_list_item.flags | join(', ') or '-' }}</td>
            <td style="padding: 8px;">{{ '-' if not student_list_item.last_changed_at else student_list_item.last_changed_at.strftime('%Y-%m-%d %H:%M %Z') }}</td>
            <td style="padding: 8px;">{{ '-' if not student_list_item.exam_title else student_list_item.exam_title }}</td>
            <td style="padding: 8px;">{% if student_list_item.state != 'finished' %}<button hx-post="/actions/end-exam" hx-vals='{}' hx-target="#student-list-table-body" hx-swap="innerHTML">End exam</button>{% endif %}</td>
        </tr>
        {% else %}
        <tr>
            <td colspan="{{ columns | length }}" style="padding: 16px; text-align: center; color: #666;">No students{% if name_birthday_filter %}{{ " matching '" ~ name_birthday_filter ~ "'" }}{% endif %}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endautoescape %}
