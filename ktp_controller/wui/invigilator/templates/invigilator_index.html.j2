{% autoescape true %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ _("Invigilator's view") }}</title>
    <link rel="stylesheet" href="/static/pico.min.css">
    <style>
      #connection-lost-overlay {
        display: none;
        position: fixed;
        inset: 0;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(5px);
        background: rgba(0, 0, 0, 0.75);
        color: white;
        font-size: 1.5em;
        text-align: center;
        z-index: 1000;
      }
      #connection-lost-overlay.is-visible {
        display: flex;
      }
      .connection-lost-content {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      header nav {
        align-items: center;
      }
      header form {
        margin-bottom: 0;
      }
      header button,
      header select {
        width: auto;
      }
      #filters {
        margin-bottom: 20px;
      }
      #name_birthday_filter {
        max-width: 32ch;
      }
    </style>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="/static/status_updates.js"></script>
    <script src="/static/locale_switcher.js"></script>
    <script src="/static/end_exam_confirm.js"></script>
</head>
<body>

    <div id="connection-lost-overlay">
        <div class="connection-lost-content">
            <p>{{ _("Connection lost at") }} <span id="connection-lost-timestamp"></span></p>
            <p>{{ _("The page will reload automatically once it's back.") }}</p>
        </div>
    </div>

    <header class="container">
        <nav>
            <ul>
                <li>{% trans user=user %}Logged in as <strong>{{ user }}</strong>{% endtrans %}</li>
            </ul>
            <ul>
                <li>
                    <form method="post" action="/locale">
                        <input type="hidden" name="next" value="{{ request.url.path }}">
                        <select name="locale" aria-label="{{ _('Language') }}">
                            <option value="fi" {{ "selected" if locale == "fi" else "" }}>Suomi</option>
                            <option value="en" {{ "selected" if locale == "en" else "" }}>English</option>
                        </select>
                    </form>
                </li>
                <li>
                    <form method="post" action="/logout">
                        <button type="submit" class="secondary">{{ _("Log out") }}</button>
                    </form>
                </li>
            </ul>
        </nav>
    </header>

    <main class="container">

        <h2>{{ _("Students") }}</h2>

        <div id="filters">
            <input type="text"
                   id="name_birthday_filter"
                   name="name_birthday_filter"
                   value="{{ name_birthday_filter }}"
                   placeholder="{{ _('Filter by student name or birthday...') }}"
                   hx-get=""
                   hx-trigger="keyup changed delay:350ms"
                   hx-target="#student-list-table"
                   hx-swap="outerHTML"
                   hx-include="#filters">
        </div>

        {% include "partials/student_list_table.html.j2" %}

    </main>

</body>
</html>
{% endautoescape %}
