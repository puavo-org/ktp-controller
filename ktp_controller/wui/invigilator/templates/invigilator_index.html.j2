{% autoescape true %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invigilator's view</title>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="/invigilator/static/status_updates.js"></script>
</head>
<body style="font-family: Arial, sans-serif; margin: 40px;">

    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>Logged in as <strong>{{ user }}</strong></div>
        <form method="post" action="/logout" style="margin: 0;">
            <button type="submit">Log out</button>
        </form>
    </div>

    <h2>Students</h2>
    
    <div id="filters" style="margin-bottom: 20px; display: flex; gap: 15px;">
        <div>
            <input type="text"
                   id="name_birthday_filter"
                   name="name_birthday_filter"
                   value="{{ name_birthday_filter }}"
                   placeholder="Filter by student name or birthday..."
                   style="min-width: 32ch;"
                   hx-get=""
                   hx-trigger="keyup changed delay:350ms"
                   hx-target="#student-list-table"
                   hx-swap="outerHTML"
                   hx-include="#filters">
        </div>
    </div>

    {% include "partials/student_list_table.html.j2" %}

</body>
</html>
{% endautoescape %}
